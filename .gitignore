# Ambiente virtual
venv/
.venv/

# Arquivos de ambiente (o modelo .env.example é versionado)
.env
*.env
!.env.example

# __pycache__ e arquivos compilados
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Arquivos de log
*.log

# Diretórios e arquivos do VSCode / PyCharm
.vscode/
.idea/

# Listas de senhas próprias não são versionadas; a de exemplo que acompanha o projeto, sim
wordlist/*
!wordlist/wordlist.example.txt

# Arquivos temporários de sistema
.DS_Store
Thumbs.db

# Arquivos do Jupyter (caso use)
.ipynb_checkpoints/
